{
  "name": "homebridge-unifi-protect-api",
  "displayName": "UniFi Protect (API)",
  "type": "module",
  "version": "1.0.5",
  "description": "Homebridge plugin for UniFi Protect using the official Integration API. API key only — no username or password.",
  "author": "Ruaan Deysel",
  "license": "Apache-2.0",
  "homepage": "https://github.com/tinkerologie/homebridge-unifi-protect-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinkerologie/homebridge-unifi-protect-api.git"
  },
  "bugs": {
    "url": "https://github.com/tinkerologie/homebridge-unifi-protect-api/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "unifi",
    "unifi-protect",
    "protect",
    "camera"
  ],
  "main": "dist/index.js",
  "files": [
    "config.schema.json",
    "dist",
    "homebridge-ui"
  ],
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22.12.0 || ^24 || ^26"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "gen:zod": "node scripts/gen-zod.mjs",
    "lint": "eslint . --max-warnings=0 && tsc -p tsconfig.test.json",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "live-check": "node scripts/live-check.mjs",
    "watch": "npm run build && npm link && nodemon",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "katex": "^0.18.2",
    "minimatch": "^11.0.8"
  }
}
